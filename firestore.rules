rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(data) {
      return request.auth != null && request.auth.uid in data.members;
    }
    match /conversations/{id} {
      allow read: if member(resource.data);
      // Backend checks current MySQL status/role on every write.
      allow write: if false;
      match /messages/{message} {
        allow read: if member(get(/databases/$(database)/documents/conversations/$(id)).data);
        allow write: if false;
      }
    }
  }
}
